# Copia questo file in .env e cambia i valori prima di avviare lo stack.
#   cp .env.example .env
#
# .env è ignorato da git: non committare mai la versione con i valori reali.
# Evita i caratteri `$` nelle password (Grafana espande le variabili nei provisioning file).

# Utente ClickHouse creato dal container (non vuoto, obbligatorio)
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=replace-me-clickhouse-password
CLICKHOUSE_DB=otel

# Credenziali iniziali di Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me-grafana-password

# Porta host di Grafana (default 3000). Cambiala se la 3000 è già occupata.
# GRAFANA_HOST_PORT=3000
